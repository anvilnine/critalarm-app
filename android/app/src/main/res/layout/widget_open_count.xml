<?xml version="1.0" encoding="utf-8"?>
<!-- The 1x1 open count widget, home screen or lock screen. The text below is
     its picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/count_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/count_face"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_face_preview" />

        <TextView
            android:id="@+id/count_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp"
            android:text="1"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="open"
            android:textColor="@color/widget_ink_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/count_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/widget_ink_muted"
        android:textSize="10sp"
        android:visibility="gone" />
</FrameLayout>
