<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Talking to the user's own Crit Alarm server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Notifications. POST_NOTIFICATIONS is the Android 13+ runtime prompt.
         RECEIVE_BOOT_COMPLETED lets a pending alarm survive a reboot.
         A2 adds USE_FULL_SCREEN_INTENT and the high-importance alarm channel. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Android 16 Live Updates: lifts the incident card onto the lock screen
         and into the status bar chip. The user can turn it off per app. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- The sound recorder. Asked for on the first tap of its record button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- Onboarding's local test alarm has to ring at the second it promised,
         so it is an exact alarm rather than a window the system can shift. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Firebase Analytics pulls in the advertising ID permissions on its
         own. The app shows no ads and does no ad attribution, so drop them
         and tell Analytics not to read the ID. Keeps the Play Console
         "Advertising ID" answer a plain no. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>

    <application
        android:allowBackup="true"
        android:label="Crit Alarm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- MainActivity routes a tapped notification itself, off the
                 extras, and hands go_router a path. The tap intents also carry
                 a critalarm:// data URI, which is only there to keep two
                 PendingIntents apart: there is no intent-filter for that scheme
                 and nothing outside the app sends one. Left on, Flutter's own
                 deep link handling reads that URI whenever the extras are gone,
                 already taken or replayed from recents, and go_router answers
                 "no routes for location: critalarm://incidents/inc_demo". -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
        </activity>
        <!-- The launcher entries, one per app icon. MainActivity has no
             LAUNCHER filter of its own: each alias below carries one, and the
             app enables exactly one at a time (appicon/AppIconChannel.kt).
             Default is the only one enabled here, so a fresh install shows the
             default icon. The three Pro icons are picked in Settings. -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherProCrowned"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pro_crowned">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherProShades"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pro_shades">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherProShadesCrown"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pro_shades_crown">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- "Share to Crit Alarm". Takes ACTION_SEND for audio only, copies
             the file and hands it to MainActivity. The filter is not on
             MainActivity because a share there would start a second Flutter
             engine inside the sending app. No ACTION_VIEW, which would put
             the app in every "Open with" list for music. -->
        <activity
            android:name=".sound.ShareReceiverActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: fires scheduled notifications and
             reschedules them after a device reboot or an app update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".push.CritAlarmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".alarm.AlarmForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-call alarm" />
        </service>
        <receiver
            android:name=".actions.IncidentActionReceiver"
            android:exported="false" />
        <!-- Starts the alarm service for a local alarm set earlier, with no
             push involved. Onboarding's test alarm is the only caller. -->
        <receiver
            android:name=".alarm.ScheduledAlarmReceiver"
            android:exported="false" />
        <!-- Local reminders. AlarmManager fires LocalReminderReceiver; the boot
             receiver re-arms them after a reboot, an update, or a clock or
             time zone change; the action receiver handles "Not now" without
             opening the app. -->
        <receiver
            android:name=".localreminders.LocalReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".localreminders.LocalReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".localreminders.LocalReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>

        <!-- Home screen widgets. They read the snapshot in the
             critalarm_widgets preferences and never ring or notify. The
             launcher needs the receivers exported to send them updates. -->
        <receiver
            android:name=".widgets.TopicListWidgetProvider"
            android:exported="true"
            android:label="@string/widget_topic_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_topic_list_info" />
        </receiver>
        <receiver
            android:name=".widgets.TopicWidgetProvider"
            android:exported="true"
            android:label="@string/widget_topic_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_topic_info" />
        </receiver>
        <receiver
            android:name=".widgets.OpenCountWidgetProvider"
            android:exported="true"
            android:label="@string/widget_open_count_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_count_info" />
        </receiver>
        <activity
            android:name=".widgets.TopicWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
