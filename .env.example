# RevenueCat public SDK keys, from Project settings > API keys in the
# RevenueCat dashboard. One per store, and the SDK rejects the other store's
# key, so both platforms need their own line.
#
#   REVENUECAT_ANDROID_API_KEY  the Google Play key, starts with goog_
#   REVENUECAT_IOS_API_KEY      the App Store key, starts with appl_
#
# A key starting with test_ is the Test Store. It only works in a debug build:
# a release build throws "Test Store API key used in Release build" on launch.
# Launch is Android first, so REVENUECAT_ANDROID_API_KEY is the one that has to
# be a real goog_ key.
REVENUECAT_ANDROID_API_KEY=goog_your_google_play_sdk_key_here
REVENUECAT_IOS_API_KEY=appl_your_app_store_sdk_key_here

# Google sign-in OAuth clients. The iOS client is used on iOS only; the web
# client is passed as the server client on both platforms.
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here
GOOGLE_SERVER_CLIENT_ID=your_google_web_client_id_here
