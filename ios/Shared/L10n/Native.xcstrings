    "native.alarm.still_ringing" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále zvoní. Ukonči ho klepnutím na Už jsem vzhůru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt noch. Tippe auf Ich bin wach, um es zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still ringing. Tap I'm up to end it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue sonando. Toca \"Ya voy\" para detenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne toujours. Touchez « Je suis debout » pour l’arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona ancora. Tocca \"Arrivo\" per fermarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ鳴っています。「起きました」をタップすると鳴り止みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 울리고 있어요. '일어났어요'를 눌러 알람을 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat nog af. Tik op \"Ik ben wakker\" om te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal dzwoni. Stuknij „Już nie śpię”, aby go wyłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua tocando. Toque em \"Já acordei\" para parar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hâlâ çalıyor. Durdurmak için Uyandım'a dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досі дзвонить. Натисни «Не сплю», щоб зупинити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还在响。点“我醒了”即可停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還在響鈴。點「我醒了」即可停止。"
          }
        }
      }
    },
