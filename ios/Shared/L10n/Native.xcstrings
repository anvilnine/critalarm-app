    "native.card.still_open_line" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále otevřeno. Je to vyřešené? Klepni na Hotovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch offen. Tippe auf Erledigt, wenn es behoben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still open. Tap Done if it's fixed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue abierto. Toca Listo si ya está resuelto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours ouvert. Touchez « Terminé » si c’est réglé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora aperto. Tocca \"Fatto\" se è risolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ未完了です。直っていれば「完了」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 진행 중이에요. 해결했다면 '완료'를 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog open. Tik op Klaar als het is opgelost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal otwarty. Stuknij „Gotowe”, jeśli problem został rozwiązany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda aberto. Se já resolveu, toque em \"Concluído\"."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hâlâ açık. Çözüldüyse Bitti'ye dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досі відкрито. Якщо все виправлено, натисни «Готово»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未关闭。处理好了就点“完成”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未結束。處理好了就點「完成」。"
          }
        }
      }
    },
