    "native.card.silenced" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztišeno. Za {seconds} s zazvoní znovu. Ukonči ho klepnutím na Už jsem vzhůru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt. Klingelt in {seconds} s erneut. Tippe auf Ich bin wach, um es zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped. Rings again in {seconds} s. Tap I'm up to end it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenciada. Volverá a sonar en {seconds} s. Toca \"Ya voy\" para apagarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son coupé. Sonne à nouveau dans {seconds} s. Touchez « Je suis debout » pour l’arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenziato. Suona di nuovo tra {seconds} s. Tocca \"Arrivo\" per fermarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止しました。{seconds}秒後にまた鳴ります。「起きました」をタップすると鳴り止みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리 꺼짐. {seconds}초 후 다시 울려요. '일어났어요'를 눌러 알람을 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestopt. Gaat over {seconds} s weer af. Tik op Ik ben wakker om het te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyciszony. Zadzwoni ponownie za {seconds} s. Stuknij „Już nie śpię”, aby go wyłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parou. Toca de novo em {seconds} s. Toque em \"Já acordei\" para encerrar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susturuldu. {seconds} sn sonra tekrar çalacak. Durdurmak için Uyandım'a dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук вимкнено. Знову задзвонить через {seconds} с. Натисни «Не сплю», щоб зупинити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已消音。{seconds}秒后再次响铃。点“我醒了”即可停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暫停響鈴。{seconds} 秒後再次響鈴。點「我醒了」即可結束。"
          }
        }
      }
    },
