# Copy to scripts/push/apns.env and fill in. apns.env is git-ignored.
# The .p8 itself never goes in the repo: keep it above the checkout or in a
# password manager.

# Certificates, Identifiers & Profiles > Keys. The file is downloadable once.
APNS_KEY_PATH=../AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

APNS_BUNDLE_ID=app.critalarm

# Printed by the app on launch in a debug build:
#   CritAlarm: apns_token=<64 hex characters>
APNS_DEVICE_TOKEN=

# Where the extension fetches the incident. A handset cannot reach the Mac's
# loopback, so this has to be the Mac's address on the same network.
APNS_SERVER=http://192.168.1.10:8787

# api.md §5.1 sets apns-expiration to now + max_ring_s.
APNS_EXPIRATION_S=1800

# Set to 1 only once the Critical Alerts entitlement is on the App ID.
# Until then a critical payload is downgraded to time-sensitive before it is
# sent, because APNs rejects the critical level without it.
APNS_CRITICAL_ALERTS=0

# Live Activity tokens, printed by the app in a debug build:
#   CritAlarmActivity: push_to_start_token length=64
#   CritAlarmActivity: activity_update_token incident_id=... length=64
# Read the full hex out of the device console. la-start.apns needs the first,
# la-update.apns and la-end.apns the second.
APNS_LA_START_TOKEN=
APNS_LA_UPDATE_TOKEN=
